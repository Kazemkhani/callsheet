EXA_API_KEY=            # exa.ai dashboard
OPENAI_API_KEY=         # or OPENROUTER_API_KEY (chat-completions mode)
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=     # @BotFather
SLACK_BOT_TOKEN=        # xoxb-  (Install App page)
SLACK_APP_TOKEN=        # xapp-  (Basic Information > App-Level Tokens, scope connections:write)
