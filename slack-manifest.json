{
  "display_information": {
    "name": "Callsheet",
    "description": "The staffing coordinator that lives in your crew channel",
    "background_color": "#1a1917"
  },
  "features": {
    "bot_user": { "display_name": "Callsheet", "always_online": true },
    "app_home": { "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "slash_commands": [
      {
        "command": "/staff",
        "description": "Staff an event from a plain-English request",
        "usage_hint": "60 for AI Everything Summit, 6-7 Oct, 10 each: Stage, Kids Zone, F&B ..."
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read", "chat:write", "chat:write.public",
        "channels:history", "channels:read", "groups:history",
        "im:history", "im:read", "im:write", "commands",
        "reactions:write", "users:read", "files:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels", "message.im"] },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
